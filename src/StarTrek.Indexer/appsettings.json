{
  "Indexer": {
    "Paths": {
      "Corpus": "SourceFiles",
      "Staging": "Data/staging",
      "EmbeddingModel": "Models/multilingual-e5-small",
      "Bm25Corpus": "Data/bm25/corpus.json"
    },
    "Chroma": {
      "Endpoint": "http://127.0.0.1:8000",
      "Collection": "startrek",
      "Tenant": "default_tenant",
      "Database": "default_database"
    },
    "Chunking": {
      "TargetTokenLimit": 480,
      "ShortSectionThreshold": 80,
      "EmbeddingMaxTokens": 512,
      "OverlapMaxSentences": 2,
      "OverlapMaxTokens": 120,
      "TokenWindowOverlapTokens": 32
    },
    "Bm25": {
      "K1": 1.5,
      "B": 0.75
    },
    "Search": {
      "RrfK": 60,
      "VectorTopN": 20,
      "Bm25TopN": 20,
      "ResultCount": 10
    }
  },
  "Llm": {
    "Endpoint": "http://localhost:11434",
    "Model": "qwen3.5:4b",
    "Temperature": 0.1,
    "TimeoutSeconds": 30,
    "MaxOutputTokens": 128,
    "MaxRewrittenCharacters": 400,
    "DisableThinking": true
  }
}
